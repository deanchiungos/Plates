<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.tagsmedia.tags</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>plates</string>
			</array>
		</dict>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Plate Game</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>License Plates</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_plates-party._tcp</string>
		<string>_plates-party._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Tags uses the local network to find the other phones in your car, so everyone can share the plates they spot. What you spot goes straight to them and never through us.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Tags listens so a passenger can call out plates instead of tapping them. It only listens while voice mode is open.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Tags turns what you say into plate sightings. Where your iPhone can do the recognition itself it does, and your speech stays on it. Where it cannot, Apple transcribes it.</string>
	<key>UIAppFonts</key>
	<array>
		<string>overpass-regular.otf</string>
		<string>overpass-semibold.otf</string>
		<string>overpass-bold.otf</string>
		<string>overpass-heavy.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
