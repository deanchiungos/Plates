<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.eggeppel.plates</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>plates</string>
			</array>
		</dict>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>INAlternativeAppNames</key>
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Plate Game</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>License Plates</string>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBonjourServices</key>
	<array>
		<string>_plates-party._tcp</string>
		<string>_plates-party._udp</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Plates uses the local network to find the other phones in your car, so everyone can share the plates they spot.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Voice mode listens while you drive so you can call out plates instead of tapping them.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Voice mode turns what you say into plate sightings. Recognition runs on your iPhone wherever the device supports it, so your speech does not leave it.</string>
	<key>UIAppFonts</key>
	<array>
		<string>overpass-regular.otf</string>
		<string>overpass-semibold.otf</string>
		<string>overpass-bold.otf</string>
		<string>overpass-heavy.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
