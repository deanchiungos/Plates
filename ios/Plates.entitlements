<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Deliberately kept beside the .xcodeproj rather than inside Plates/, which is a
	  PBXFileSystemSynchronizedRootGroup — anything dropped in there is picked up by
	  the build automatically, and an entitlements plist is not something that should
	  ever end up copied into the bundle as a resource.
	-->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.eggeppel.plates</string>
	</array>
	<!--
	  Shared with the widget extension, which runs in its own process and can only
	  read what the app has deliberately put somewhere both can reach. Only the small
	  Widget.json sidecar goes here — the SwiftData store stays where it is, because
	  moving it would mean migrating everybody's plates to get a number onto a home
	  screen. See `WidgetData`.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.eggeppel.plates</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
